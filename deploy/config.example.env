# Deploy settings, sourced by the deploy and read-back scripts.
# Copy to deploy/config.env (gitignored) and fill it in. Never commit real values.

# The GCP project the trial runs in.
PROJECT_ID="your-project-id"

# Region for everything (ADR-0009, D6). Fixed, not a personal value.
REGION="europe-west2"

# The Artifact Registry Docker repository, in REGION.
AR_REPO="your-repository-name"

# The service's URL. Leave empty until the first deploy prints it.
SERVICE_URL=""

# Who IAP lets in: IAM principals, space-separated.
# The developer only until mvp-cutover (TODO.md).
IAP_MEMBERS="user:you@example.com"
