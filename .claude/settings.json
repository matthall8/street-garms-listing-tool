{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest)",
      "Bash(.venv/bin/python -m pytest -rs)",
      "Bash(.venv/bin/python -m pytest -q)",
      "Bash(.venv/bin/ruff check .)",
      "Bash(.venv/bin/pyright)",
      "Bash(.venv/bin/python tests/report_art_number.py)",
      "Bash(.venv/bin/python tests/eval_transcription.py --model test --no-save)",
      "Bash(git check-ignore *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Edit(./hooks/**)",
      "Read(./data/**)",
      "Read(./images/**)",
      "Read(./evals/photos/**)",
      "Read(./evals/archive/**)",
      "Read(./evals/results/**)",
      "Read(./evals/manifest.csv)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./.envrc)",
      "Edit(./evals/manifest.csv)",
      "Edit(./data/**)",
      "Edit(./images/**)",
      "Edit(./evals/photos/**)",
      "Edit(./evals/archive/**)",
      "Edit(./evals/results/**)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push -u origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config * core.hooksPath*)",
      "Bash(git -c core.hooksPath*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-tests.sh",
            "timeout": 120,
            "statusMessage": "Running tests"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-edited.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
